From f19b0d81c001de2034eaacf263852f4bc44b3e68 Mon Sep 17 00:00:00 2001
From: fxc2 <fxc2@localhost>
Date: Wed, 7 Oct 2026 05:08:37 +0200
Subject: [PATCH 1/3] vkd3d-shader/hlsl: Do not implicitly unroll SM4+ loops.

---
 libs/vkd3d-shader/hlsl_codegen.c | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/libs/vkd3d-shader/hlsl_codegen.c b/libs/vkd3d-shader/hlsl_codegen.c
index b0e28f30..34fc8450 100644
--- a/libs/vkd3d-shader/hlsl_codegen.c
+++ b/libs/vkd3d-shader/hlsl_codegen.c
@@ -16079,6 +16079,21 @@ static bool unroll_loops(struct hlsl_ctx *ctx, struct hlsl_ir_node *node, void *
     if (loop->unroll_type == HLSL_LOOP_FORCE_LOOP)
         return false;
 
+    /* fxc2: speculatively unrolling every loop, as upstream does to mimic
+     * FXC, makes compile time and code size explode on loop-heavy SM4+
+     * shaders. Only unroll loops marked [unroll], unless the
+     * VKD3D_HLSL_IMPLICIT_UNROLL_LIMIT environment variable sets a limit. */
+    if (loop->unroll_type != HLSL_LOOP_FORCE_UNROLL && hlsl_version_ge(ctx, 4, 0))
+    {
+        const char *limit = getenv("VKD3D_HLSL_IMPLICIT_UNROLL_LIMIT");
+
+        if (!limit || !(unroll_limit = strtoul(limit, NULL, 0)))
+        {
+            loop->unroll_type = HLSL_LOOP_FORCE_LOOP;
+            return false;
+        }
+    }
+
     if (loop->unroll_limit.node)
     {
         struct hlsl_ir_constant *c;
