From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: fxc2 <fxc2@localhost>
Date: Wed, 28 Oct 2026 02:00:00 +0100
Subject: [PATCH 65/65] vkd3d-shader/preproc: Predefine __FXC2_VERSION__.

---
 libs/vkd3d-shader/preproc.l | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/libs/vkd3d-shader/preproc.l b/libs/vkd3d-shader/preproc.l
--- a/libs/vkd3d-shader/preproc.l
+++ b/libs/vkd3d-shader/preproc.l
@@ -935,8 +935,25 @@ int preproc_lexer_parse(const struct vkd3d_shader_compile_info *compile_info,
             vkd3d_string_buffer_cleanup(&body);
             goto fail;
         }
     }

+    /* fxc2: the number of the newest patch it was built with (fxc2_version.h, which
+     * scripts/build-vkd3d.sh writes), so a shader can refuse an older fxc2 with #error. */
+    {
+#include "fxc2_version.h"
+        struct vkd3d_string_buffer body;
+        char *name;
+
+        vkd3d_string_buffer_init(&body);
+        vkd3d_string_buffer_printf(&body, "%u", (unsigned int)FXC2_VERSION);
+        if (!(name = vkd3d_strdup("__FXC2_VERSION__")) || !preproc_add_macro(&ctx, &loc, name, NULL, 0, &loc, &body))
+        {
+            vkd3d_free(name);
+            vkd3d_string_buffer_cleanup(&body);
+            goto fail;
+        }
+    }
+
     for (i = 0; i < ctx.preprocess_info->macro_count; ++i)
     {
         struct vkd3d_string_buffer body;
--
2.53.0

