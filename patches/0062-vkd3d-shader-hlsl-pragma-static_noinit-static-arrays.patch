From ea427b072139cac5424f8f3e650041c83f2654c3 Mon Sep 17 00:00:00 2001
From: fxc2 <fxc2@localhost>
Date: Mon, 26 Oct 2026 08:07:31 +0100
Subject: [PATCH] vkd3d-shader/hlsl: #pragma static_noinit: static arrays
 declared after it are not zeroed.

---
 libs/vkd3d-shader/hlsl.h | 2 ++
 libs/vkd3d-shader/hlsl.l | 6 ++++++
 libs/vkd3d-shader/hlsl.y | 6 +++++-
 3 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/libs/vkd3d-shader/hlsl.h b/libs/vkd3d-shader/hlsl.h
index b8dad90b..e7e4c88c 100644
--- a/libs/vkd3d-shader/hlsl.h
+++ b/libs/vkd3d-shader/hlsl.h
@@ -1248,6 +1248,8 @@ struct hlsl_ctx
 
     /* Default matrix majority for matrix types. Can be set by a pragma within the HLSL source. */
     unsigned int matrix_majority;
+    /* #pragma static_noinit: static arrays declared after it are not zeroed. */
+    bool static_noinit;
 
     /* Basic data types stored for convenience. */
     struct
diff --git a/libs/vkd3d-shader/hlsl.l b/libs/vkd3d-shader/hlsl.l
index 9896275d..7db4f7b9 100644
--- a/libs/vkd3d-shader/hlsl.l
+++ b/libs/vkd3d-shader/hlsl.l
@@ -310,6 +310,12 @@ while                   {return KW_WHILE;               }
                             ctx->matrix_majority = HLSL_MODIFIER_COLUMN_MAJOR;
                             BEGIN(pp_ignore);
                         }
+<pp_pragma>static_noinit {
+                            struct hlsl_ctx *ctx = yyget_extra(yyscanner);
+
+                            ctx->static_noinit = true;
+                            BEGIN(pp_ignore);
+                        }
 <pp_pragma>{NEWLINE}    {
                             struct hlsl_ctx *ctx = yyget_extra(yyscanner);
 
diff --git a/libs/vkd3d-shader/hlsl.y b/libs/vkd3d-shader/hlsl.y
index 9cf3576b..4790ac53 100644
--- a/libs/vkd3d-shader/hlsl.y
+++ b/libs/vkd3d-shader/hlsl.y
@@ -2873,7 +2873,11 @@ static struct hlsl_block *initialize_vars(struct hlsl_ctx *ctx, struct list *var
 
             /* Initialize statics to zero by default. */
 
-            if (type_has_object_components(var->data_type))
+            /* Not after #pragma static_noinit for an array: a shader that writes
+             * every element before it reads one (with an index known only at run
+             * time) would otherwise store to all of them on entry. */
+            if (type_has_object_components(var->data_type)
+                    || (ctx->static_noinit && var->data_type->class == HLSL_CLASS_ARRAY))
             {
                 free_parse_variable_def(v);
                 continue;
-- 
2.53.0

