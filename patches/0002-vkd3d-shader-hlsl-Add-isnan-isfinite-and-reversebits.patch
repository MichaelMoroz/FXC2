From bf0ea6a1a154f7bdee98b8f91d8d4117888d2247 Mon Sep 17 00:00:00 2001
From: fxc2 <fxc2@localhost>
Date: Wed, 7 Oct 2026 04:54:00 +0200
Subject: [PATCH 02/47] vkd3d-shader/hlsl: Add isnan(), isfinite() and
 reversebits().

---
 libs/vkd3d-shader/hlsl.y | 77 ++++++++++++++++++++++++++++++++++++++++
 1 file changed, 77 insertions(+)

diff --git a/libs/vkd3d-shader/hlsl.y b/libs/vkd3d-shader/hlsl.y
index 0f9a5ac8..4676a996 100644
--- a/libs/vkd3d-shader/hlsl.y
+++ b/libs/vkd3d-shader/hlsl.y
@@ -4237,6 +4237,80 @@ static bool intrinsic_isinf(struct hlsl_ctx *ctx,
     return !!add_expr(ctx, params->instrs, HLSL_OP1_ISINF, args, bool_type, loc);
 }
 
+/* fxc2: bit pattern tests, so that they survive any float folding. */
+static bool intrinsic_float_class_test(struct hlsl_ctx *ctx, const struct parse_initializer *params,
+        const struct vkd3d_shader_location *loc, const char *name, const char *test)
+{
+    struct hlsl_ir_function_decl *func;
+    struct hlsl_type *type, *bool_type;
+    char *body;
+
+    static const char template[] =
+            "%s %s(%s x)\n"
+            "{\n"
+            "    return %s;\n"
+            "}";
+
+    if (!elementwise_intrinsic_float_convert_args(ctx, params, loc))
+        return false;
+    type = params->args[0]->data_type;
+    bool_type = hlsl_change_base_type(ctx, type, HLSL_TYPE_BOOL);
+
+    if (!(body = hlsl_sprintf_alloc(ctx, template, bool_type->name, name, type->name, test)))
+        return false;
+    func = hlsl_compile_internal_function(ctx, name, body);
+    vkd3d_free(body);
+    if (!func)
+        return false;
+
+    return !!add_user_call(ctx, func, params, loc);
+}
+
+static bool intrinsic_isfinite(struct hlsl_ctx *ctx,
+        const struct parse_initializer *params, const struct vkd3d_shader_location *loc)
+{
+    return intrinsic_float_class_test(ctx, params, loc, "isfinite",
+            "(asuint(x) & 0x7f800000u) != 0x7f800000u");
+}
+
+static bool intrinsic_isnan(struct hlsl_ctx *ctx,
+        const struct parse_initializer *params, const struct vkd3d_shader_location *loc)
+{
+    return intrinsic_float_class_test(ctx, params, loc, "isnan",
+            "(asuint(x) & 0x7fffffffu) > 0x7f800000u");
+}
+
+static bool intrinsic_reversebits(struct hlsl_ctx *ctx,
+        const struct parse_initializer *params, const struct vkd3d_shader_location *loc)
+{
+    struct hlsl_ir_function_decl *func;
+    struct hlsl_type *type;
+    char *body;
+
+    static const char template[] =
+            "%s reversebits(%s v)\n"
+            "{\n"
+            "    v = ((v >> 1) & 0x55555555u) | ((v & 0x55555555u) << 1);\n"
+            "    v = ((v >> 2) & 0x33333333u) | ((v & 0x33333333u) << 2);\n"
+            "    v = ((v >> 4) & 0x0f0f0f0fu) | ((v & 0x0f0f0f0fu) << 4);\n"
+            "    v = ((v >> 8) & 0x00ff00ffu) | ((v & 0x00ff00ffu) << 8);\n"
+            "    return (v >> 16) | (v << 16);\n"
+            "}";
+
+    if (!elementwise_intrinsic_uint_convert_args(ctx, params, loc))
+        return false;
+    type = params->args[0]->data_type;
+
+    if (!(body = hlsl_sprintf_alloc(ctx, template, type->name, type->name)))
+        return false;
+    func = hlsl_compile_internal_function(ctx, "reversebits", body);
+    vkd3d_free(body);
+    if (!func)
+        return false;
+
+    return !!add_user_call(ctx, func, params, loc);
+}
+
 static bool intrinsic_ldexp(struct hlsl_ctx *ctx,
         const struct parse_initializer *params, const struct vkd3d_shader_location *loc)
 {
@@ -5620,7 +5694,9 @@ intrinsic_functions[] =
     {"frac",                                1, true,  intrinsic_frac},
     {"frexp",                               2, true,  intrinsic_frexp},
     {"fwidth",                              1, true,  intrinsic_fwidth},
+    {"isfinite",                            1, true,  intrinsic_isfinite},
     {"isinf",                               1, true,  intrinsic_isinf},
+    {"isnan",                               1, true,  intrinsic_isnan},
     {"ldexp",                               2, true,  intrinsic_ldexp},
     {"length",                              1, true,  intrinsic_length},
     {"lerp",                                3, true,  intrinsic_lerp},
@@ -5640,6 +5716,7 @@ intrinsic_functions[] =
     {"rcp",                                 1, true,  intrinsic_rcp},
     {"reflect",                             2, true,  intrinsic_reflect},
     {"refract",                             3, true,  intrinsic_refract},
+    {"reversebits",                         1, true,  intrinsic_reversebits},
     {"round",                               1, true,  intrinsic_round},
     {"rsqrt",                               1, true,  intrinsic_rsqrt},
     {"saturate",                            1, true,  intrinsic_saturate},
