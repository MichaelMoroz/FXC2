From 1e4595cb7f6467693f0f4f10db4dc99b54e5ec90 Mon Sep 17 00:00:00 2001
From: fxc2 <fxc2@localhost>
Date: Fri, 9 Oct 2026 08:09:45 +0200
Subject: [PATCH 61/61] Static initialisers are only cloned for an expression
 that reads a variable of the program.

---
 libs/vkd3d-shader/hlsl.y | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/libs/vkd3d-shader/hlsl.y b/libs/vkd3d-shader/hlsl.y
index 1f313a41..9cf3576b 100644
--- a/libs/vkd3d-shader/hlsl.y
+++ b/libs/vkd3d-shader/hlsl.y
@@ -650,9 +650,13 @@ static struct hlsl_default_value evaluate_static_expression(struct hlsl_ctx *ctx
     {
         bool reads_variable = false;
 
+        /* The temporaries of the expression itself are stored to in the
+         * expression: the initialiser of each component of a variable loads
+         * one, and each cloned every static initialiser there was (190 times
+         * in a Poiyomi variant, a third of the time of compiling it). */
         LIST_FOR_EACH_ENTRY(node, &block->instrs, struct hlsl_ir_node, entry)
         {
-            if (node->type != HLSL_IR_CONSTANT && node->type != HLSL_IR_EXPR && node->type != HLSL_IR_SWIZZLE)
+            if (node->type == HLSL_IR_LOAD && !hlsl_ir_load(node)->src.var->is_synthetic)
                 reads_variable = true;
         }
 
