+#define L1_ARRAYS_A l1_cache, tlb2_tag, tlb2_pg
+#endif
+#define L1P L1_ARRAYS_P,
+#define L1P0 L1_ARRAYS_P
+#define L1A L1_ARRAYS_A,
+#define L1A0 L1_ARRAYS_A
 #else
 #define L1P
 #define L1P0
 #define L1A
 #define L1A0
 #endif
+#define tlb_state_texel(a0, a1) tlb_state_texel_l1(L1A a0, a1)
